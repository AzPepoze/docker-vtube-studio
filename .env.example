# Copy to .env if you prefer files over typing. Never commit .env. Lock it down: chmod 600 .env
# Leave everything empty to be asked interactively on first run instead —
# nothing is ever written to disk, the login lives only in the Docker volume.
STEAM_USER=
STEAM_PASS=
# Steam Guard code, only needed on first run / new IP. Expires fast.
STEAM_GUARD=
# Host-side ports (container side is fixed: 8001 API, 8080 watch page).
VTS_PORT=8001
STREAM_PORT=8080
# Publish the screen as a watch page (1) or not (0).
ENABLE_STREAM=1
# Update an already-installed VTS on start (1) or skip Steam entirely (0).
# 0 = restarts never need any login. Update explicitly when you want:
#   docker exec -it vtube-studio env VTS_UPDATE_ON_START=1 install-vts.sh
VTS_UPDATE_ON_START=0
# Password for the one-time setup browser. Leave empty for none.
VNC_PASSWORD=
