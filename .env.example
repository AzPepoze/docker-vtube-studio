# Copy to .env and fill in. Never commit .env.
STEAM_USER=
STEAM_PASS=
# Steam Guard code, only needed on first run / new IP. Expires fast.
STEAM_GUARD=
# Host-side ports (container side is fixed: 8001 API, 8080 watch page).
VTS_PORT=8001
STREAM_PORT=8080
# Publish the screen as a watch page (1) or not (0).
ENABLE_STREAM=1
# Re-install / update VTS on every start (1) or skip if already present (0).
VTS_UPDATE_ON_START=1
# Password for the one-time setup browser. Leave empty for none.
VNC_PASSWORD=
